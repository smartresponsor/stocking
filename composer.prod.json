{
  "name": "stocking/stock",
  "description": "Stocking component for the multi-domain SaaS platform: owns inventory availability, stock levels, reservations, incoming quantities, adjustments, and movements across stock locations.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-collection-query-hardening",
    "cruding/crud": "dev-master",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.7",
    "easycorp/easyadmin-bundle": "^5.5",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/console": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "dev-initial-platform-primitive",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Stocking\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Stocking\\StockingBundle",
      "require": "^8.1"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "gating/gate": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/objecting.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/cruding.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/collectioning.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/tabling-.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/viewing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@github.com:smartresponsor/interfacing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
